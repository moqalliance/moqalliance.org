---
import Layout from "../layouts/Layout.astro";
import members from "../data/members.json";
import agenda from "../data/demoqed-agenda.json";

const REGISTER_URL = "https://ti.to/moq-alliance/demoqed-2026";
// Placeholder. Swap when the CFP form is live.
const CFP_URL =
	"mailto:hello@moqalliance.org?subject=DEMOQED%202026%20talk%20submission";

const description =
	"DEMOQED is the MoQ Alliance conference: a single-track afternoon of talks from developers building on Media over QUIC, followed by a happy hour. San Francisco, October 8, 2026, during SF Tech Week.";

const talkCount = agenda.filter((i) => i.kind === "talk").length;
---

<Layout title="DEMOQED · MoQ Alliance Conference" description={description} wide>
	<div class="demoqed">
		<header class="hero">
			<div class="shell">
				<p class="eyebrow">The MoQ Alliance conference</p>

				<h1 class="wordmark">
					<span class="w-dim">DE</span><span class="moq-stack"
						><span class="moq-glow" aria-hidden="true">MOQ</span
						><span class="w-moq">MOQ</span></span
					><span class="w-dim">ED</span>
				</h1>

				<p class="tagline">
					An afternoon of talks from the developers building on Media
					over QUIC.
				</p>

				<ul class="facts">
					<li>San Francisco</li>
					<li>Oct 8, 2026</li>
					<li>1pm to 8pm</li>
					<li>SF Tech Week</li>
				</ul>

				<div class="cta-row">
					<a class="btn btn-primary" href={REGISTER_URL}>
						Register
					</a>
					<a class="btn btn-ghost" href={CFP_URL}>Submit a talk</a>
				</div>

				<p class="hero-note">
					Single track. No sponsor keynotes. Room for 150 to 200
					people.
				</p>
			</div>
		</header>

		<section class="strip">
			<div class="shell strip-grid">
				<div class="stat">
					<span class="stat-n">4</span>
					<span class="stat-l">hours, one track</span>
				</div>
				<div class="stat">
					<span class="stat-n">{talkCount}</span>
					<span class="stat-l">talks, 30 min each</span>
				</div>
				<div class="stat">
					<span class="stat-n">150<span class="stat-sep">-</span>200</span>
					<span class="stat-l">attendees</span>
				</div>
			</div>
		</section>

		<section class="block">
			<div class="shell narrow">
				<h2 class="h">What it is</h2>
				<p class="big">
					DEMOQED is organized by the <a href="/">MoQ Alliance</a>,
					the industry organization working to make Media over QUIC
					successful, open, and interoperable.
				</p>
				<p>
					DEMOQED covers what gets built on top of MoQ. Protocol
					design stays at the <a
						href="https://datatracker.ietf.org/wg/moq/about/"
						>IETF</a
					>. Talks come from developers who already run MoQ in their
					stack: live video, streaming platforms, conferencing, games,
					broadcast.
				</p>
				<p>
					It is deliberately small. At 150 to 200 people you can find
					the person who already shipped the thing you are about to
					build and get a straight answer the same afternoon.
					Speakers show working code and real numbers. Sales decks do
					not get a slot.
				</p>

				<h2 class="h">During SF Tech Week</h2>
				<p>
					October 8 lands inside SF Tech Week, so if you are already
					in the city that week, DEMOQED slots into the schedule
					without a separate trip. Talks run 1pm to 5pm, then the
					happy hour goes from 6pm until 8pm. Your ticket covers all
					of it.
				</p>
			</div>
		</section>

		<section class="block">
			<div class="shell">
				<h2 class="h">Agenda</h2>
				<p class="sub">
					Program in progress. Six speaking slots are open and the
					call for talks is live.
				</p>

				<ol class="agenda">
					{
						agenda.map((item) => (
							<li class={`row row-${item.kind}`}>
								<span class="row-time">{item.time}</span>
								<span class="row-body">
									{item.kind === "talk" ? (
										<>
											<span class="row-slot">
												Talk {item.slot}
											</span>
											<span class="row-title">
												{item.title}
											</span>
											<span class="row-speaker">
												{item.speaker}
											</span>
											<span class="row-hint">
												{item.hint}
											</span>
										</>
									) : (
										<span class="row-break">
											{item.title}
										</span>
									)}
								</span>
							</li>
						))
					}
				</ol>

				<div class="cta-row cta-row-left">
					<a class="btn btn-primary" href={CFP_URL}>
						Submit a talk
					</a>
				</div>
			</div>
		</section>

		<section class="block">
			<div class="shell">
				<h2 class="h">Who you will be in the room with</h2>
				<p class="sub">
					Engineers from MoQ Alliance member companies, including
					Akamai, AWS, Cisco, Cloudflare, Fastly, Mux, and Oracle, the
					open source teams behind moq.dev, MOQtail, OpenMOQ, and
					Iroh, and the developers shipping products on top of all of
					it.
				</p>
				<div class="member-wall">
					{
						members.map((m) => (
							<a class="chip" href={m.url} title={m.name}>
								<img src={m.logo} alt={m.name} loading="lazy" />
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="block final" id="register">
			<div class="shell narrow center">
				<h2 class="h">Come to DEMOQED</h2>
				<p class="price">$100</p>
				<p class="price-sub">
					Talks, coffee, and the happy hour. San Francisco, October 8,
					2026.
				</p>
				<div class="cta-row cta-row-center">
					<a class="btn btn-primary btn-lg" href={REGISTER_URL}>
						Register
					</a>
					<a class="btn btn-ghost btn-lg" href={CFP_URL}>
						Submit a talk
					</a>
				</div>
				<p class="hero-note">
					Questions: <a href="mailto:hello@moqalliance.org"
						>hello@moqalliance.org</a
					>
				</p>
			</div>
		</section>

		<footer class="foot">
			<div class="shell foot-inner">
				<span>DEMOQED 2026</span>
				<nav>
					<a href="/">MoQ Alliance</a>
					<a href="https://github.com/moqalliance">GitHub</a>
					<a href="https://discord.gg/neXqzCXsgD">Discord</a>
					<a href="mailto:hello@moqalliance.org">Contact</a>
				</nav>
			</div>
		</footer>
	</div>
</Layout>

<style is:global>
	/* This page runs dark in both color schemes so the HDR highlights hold up. */
	html,
	body {
		background: #050507;
		color: #ffffff;
		color-scheme: dark;
	}
</style>

<style>
	.demoqed {
		--ink: #ffffff;
		--dim: #9aa0a8;
		--faint: #5a606a;
		--line: #1e2128;
		--panel: #0b0c10;

		/* Two accents with distinct jobs: acid = anything clickable,
		   magenta = labels and brand heat. Flare only appears mid-gradient. */
		--acid: #d6ff3f;
		--magenta: #ff2e9a;
		--flare: #ff7a2f;

		--accent: var(--acid);
		--accent-ink: #16220a;

		background: #050507;
		font-family:
			"JetBrains Mono", "SF Mono", ui-monospace, Menlo, Monaco, Consolas,
			monospace;
		font-size: 15px;
		line-height: 1.6;
		color: var(--dim);
	}

	.impact,
	.wordmark,
	.stat-n,
	.h,
	.price,
	.btn,
	.row-slot {
		font-family: Impact, "Haettenschweiler", "Franklin Gothic Bold",
			"Arial Narrow Bold", "Anton", sans-serif;
		font-weight: 400;
		letter-spacing: 0.01em;
	}

	.shell {
		max-width: 1040px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.shell.narrow {
		max-width: 720px;
	}

	.shell.center {
		text-align: center;
	}

	/* ---------- HDR ---------- */

	/*
	 * SDR baseline first. On a display with HDR headroom the same elements are
	 * re-declared in the Rec.2100 HLG space, where values approaching 1.0 map
	 * above SDR white and the text physically glows.
	 */
	/*
	 * HDR wordmark. The brightness comes from the image, not from CSS colours:
	 * a 489-byte AVIF encoded in Rec.2100 PQ / BT.2020, whose stops all peak at
	 * 4000 cd/m2 (PQ 0.9026). SDR reference white is 203 cd/m2, so on a display
	 * with headroom these letters render far brighter than the page white.
	 * background-clip:text masks that image to the glyphs.
	 *
	 * CSS color(rec2100-*) does NOT produce HDR: browsers parse it and clamp.
	 * An HDR image is currently the only reliable route.
	 */
	.w-moq {
		--paint: url("data:image/avif;base64,");
		color: var(--magenta);
		text-shadow: 0 0 0.28em rgba(255, 46, 154, 0.4);
	}

	/*
	 * The glow is a separate SDR copy sitting behind the HDR text. It has to be
	 * its own element: a filter applied to .w-moq itself would rasterise the
	 * AVIF into an SDR buffer and clamp away the headroom. Filters are free
	 * here because this layer was never HDR to begin with.
	 */
	.moq-stack {
		position: relative;
		display: inline-block;
	}

	.moq-glow {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 0;
		white-space: nowrap;
		pointer-events: none;
		user-select: none;
		color: var(--magenta);
	}

	@supports (
		(-webkit-background-clip: text) or (background-clip: text)
	) {
		.w-moq {
			background-image: var(--paint);
			background-size: 100% 100%;
			background-repeat: no-repeat;
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
			text-shadow: none;
			dynamic-range-limit: no-limit;
			position: relative;
			z-index: 1;
		}

		.moq-glow {
			background-image: linear-gradient(
				100deg,
				var(--magenta) 0%,
				var(--flare) 52%,
				var(--acid) 100%
			);
			background-size: 100% 100%;
			background-repeat: no-repeat;
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
			filter: blur(0.05em) drop-shadow(0 0 0.16em rgba(255, 46, 154, 0.5))
				drop-shadow(0 0 0.34em rgba(214, 255, 63, 0.28));
		}
	}

	.w-dim {
		color: var(--ink);
	}

	/* Wider-gamut P3 overrides live at the end of this file so they win on
	   source order against the base colours declared below. */

	/* ---------- hero ---------- */

	.hero {
		padding: 6rem 0 4.5rem;
		border-bottom: 1px solid var(--line);
		background:
			radial-gradient(
				70% 60% at 16% -10%,
				rgba(255, 46, 154, 0.22),
				transparent 62%
			),
			radial-gradient(
				70% 60% at 84% -8%,
				rgba(214, 255, 63, 0.15),
				transparent 62%
			),
			#050507;
	}

	.eyebrow {
		margin: 0 0 1.75rem;
		font-size: 0.72rem;
		letter-spacing: 0.34em;
		text-transform: uppercase;
		color: var(--magenta);
	}

	.wordmark {
		margin: 0;
		font-size: clamp(4.5rem, 19vw, 15rem);
		line-height: 0.82;
		letter-spacing: -0.015em;
		text-transform: uppercase;
		font-weight: 400;
	}

	.tagline {
		margin: 2rem 0 0;
		max-width: 34ch;
		font-size: 1.05rem;
		color: var(--ink);
		line-height: 1.5;
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.75rem;
		list-style: none;
		margin: 2.25rem 0 0;
		padding: 0;
		font-size: 0.78rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.facts li {
		position: relative;
		margin: 0;
	}

	/* global.css puts an em-dash bullet on every `ul li` */
	.facts li::before {
		content: none;
	}

	.facts li + li::before {
		content: "";
		position: absolute;
		left: -0.95rem;
		top: 50%;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--faint);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2.5rem 0 0;
	}

	.cta-row-center {
		justify-content: center;
	}

	.hero-note {
		margin: 1.75rem 0 0;
		max-width: 46ch;
		font-size: 0.85rem;
		color: var(--faint);
	}

	.center .hero-note {
		margin-left: auto;
		margin-right: auto;
	}

	/* ---------- buttons ---------- */

	.btn {
		display: inline-block;
		padding: 0.85rem 1.6rem;
		font-size: 1.15rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		border: 2px solid transparent;
		border-radius: 2px;
		transition:
			transform 0.12s ease,
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn-lg {
		padding: 1rem 2.25rem;
		font-size: 1.35rem;
	}

	.btn-primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}

	.btn-ghost {
		border-color: #2b2f38;
		color: var(--ink);
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn-ghost:hover {
		border-color: var(--ink);
	}

	/* ---------- stat strip ---------- */

	.strip {
		border-bottom: 1px solid var(--line);
		background: var(--panel);
	}

	.strip-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		padding-top: 2.25rem;
		padding-bottom: 2.25rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.stat-n {
		font-size: 2.6rem;
		line-height: 1;
		color: var(--ink);
	}

	.stat-sep {
		color: var(--faint);
		margin: 0 0.05em;
	}

	.stat-l {
		font-size: 0.74rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}

	/* ---------- blocks ---------- */

	.block {
		padding: 5.5rem 0;
		border-bottom: 1px solid var(--line);
	}

	.h {
		margin: 0 0 1.5rem;
		font-size: clamp(1.9rem, 5vw, 3.1rem);
		line-height: 1;
		text-transform: uppercase;
		color: var(--ink);
		letter-spacing: 0.005em;
	}

	.block p {
		margin: 0 0 1.25rem;
	}

	/* Scoped under .block so they beat the blanket paragraph margin above. */
	.block .big {
		font-size: 1.15rem;
		line-height: 1.55;
		color: var(--ink);
		margin: 0 0 1.4rem;
	}

	.block .sub {
		max-width: 62ch;
		margin: -0.5rem 0 2.5rem;
		color: var(--dim);
	}

	.block .center .sub {
		margin-left: auto;
		margin-right: auto;
	}

	.demoqed a {
		color: var(--acid);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.demoqed a.btn,
	.demoqed a.chip {
		text-decoration: none;
	}

	/* Must out-specify `.demoqed a`, which would otherwise paint the label
	   accent-on-accent and make the button unreadable. */
	.demoqed a.btn-primary {
		color: var(--accent-ink);
	}

	.demoqed a.btn-ghost {
		color: var(--ink);
	}

	/* ---------- agenda ---------- */

	.agenda {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.row {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1.5rem;
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--line);
		margin: 0;
	}

	.row::before {
		content: none;
	}

	.row-time {
		font-size: 0.85rem;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
		padding-top: 0.15rem;
	}

	.row-body {
		display: block;
		min-width: 0;
	}

	.row-slot {
		display: block;
		font-size: 0.8rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--magenta);
		margin-bottom: 0.3rem;
	}

	.row-title {
		display: block;
		font-size: 1.05rem;
		color: var(--ink);
	}

	.row-speaker {
		display: block;
		font-size: 0.85rem;
		color: var(--dim);
		margin-top: 0.1rem;
	}

	.row-hint {
		display: block;
		font-size: 0.82rem;
		color: var(--faint);
		margin-top: 0.45rem;
	}

	.row-break .row-time,
	.row-break {
		color: var(--dim);
	}

	.row-break {
		display: block;
		font-size: 0.9rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--faint);
		padding-top: 0.15rem;
	}

	.row-talk {
		background: linear-gradient(
			90deg,
			rgba(255, 46, 154, 0.06),
			transparent 38%
		);
	}

	/* ---------- members ---------- */

	.member-wall {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
		gap: 0.6rem;
	}

	.chip {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 68px;
		padding: 0.9rem;
		box-sizing: border-box;
		background: #ffffff;
		border-radius: 4px;
		transition:
			transform 0.12s ease,
			box-shadow 0.15s ease;
	}

	.chip img {
		max-height: 100%;
		max-width: 100%;
		object-fit: contain;
	}

	.chip:hover {
		transform: translateY(-2px);
		box-shadow: 0 0 0 2px var(--accent);
	}

	/* ---------- final ---------- */

	.final {
		background:
			radial-gradient(
				60% 110% at 24% 115%,
				rgba(255, 46, 154, 0.2),
				transparent 62%
			),
			radial-gradient(
				60% 110% at 76% 115%,
				rgba(214, 255, 63, 0.14),
				transparent 62%
			),
			#050507;
		border-bottom: none;
	}

	.price {
		margin: 0.5rem 0 0.5rem;
		font-size: clamp(4rem, 14vw, 8rem);
		line-height: 0.9;
		color: var(--ink);
	}

	.block .price-sub {
		margin: 0 auto 0.5rem;
		max-width: 40ch;
		color: var(--dim);
	}

	/* Separate the contact line from the buttons above it. */
	.final .hero-note {
		margin-top: 3.75rem;
	}

	/* ---------- footer ---------- */

	.foot {
		padding: 2.25rem 0 3rem;
		border-top: 1px solid var(--line);
	}

	.foot-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		font-size: 0.78rem;
		color: var(--faint);
	}

	.foot nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.demoqed .foot a {
		color: var(--dim);
	}

	.demoqed .foot a:hover {
		color: var(--ink);
	}

	/* ---------- responsive ---------- */

	@media (max-width: 720px) {
		.strip-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1rem 0.75rem;
		}
		.stat-n {
			font-size: 1.9rem;
		}
		.hero {
			padding: 4rem 0 3.5rem;
		}
		.block {
			padding: 3.75rem 0;
		}
		.row {
			grid-template-columns: 4.5rem 1fr;
			gap: 1rem;
		}
		.btn {
			flex: 1 1 auto;
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.btn,
		.chip {
			transition: none;
		}
		.btn:hover,
		.chip:hover {
			transform: none;
		}
	}

	/* ---------- wider gamut ---------- */

	/*
	 * Last in the file on purpose. On a P3 display these render more saturated
	 * than sRGB can express. Hues are matched to the sRGB values above, so
	 * non-P3 displays lose nothing but the extra vividness.
	 */
	@supports (color: color(display-p3 1 1 1)) {
		.demoqed {
			--acid: color(display-p3 0.82 1 0.22);
			--magenta: color(display-p3 1 0.12 0.58);
			--flare: color(display-p3 1 0.45 0.12);
		}
	}

</style>
